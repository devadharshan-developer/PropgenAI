# ProgenAI Configuration Template
# Copy this file to .env and fill in your private keys.
# DO NOT commit .env to GitHub.

# Supabase Credentials (Optional - Local mock database active by default)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_URL=
SUPABASE_ANON_KEY=

# OpenRouter AI Key (Optional - Fallback local AI generator active by default)
OPENROUTER_API_KEY=your-openrouter-key-here
